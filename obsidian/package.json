{
  "name": "peerpedia-obsidian",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:django": "PEERPEDIA_TEST_DJANGO=1 vitest run tests/remote-journey.test.ts",
    "typecheck": "tsc --noEmit",
    "check:types": "eslint .",
    "build": "tsx esbuild.config.ts production",
    "package": "tsx scripts/package-plugin.ts",
    "check:community": "cd .. && obsidian/node_modules/.bin/eslint --config eslint.community.config.mjs obsidian/src obsidian/renderer manifest.json package.json LICENSE"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "22.19.15",
    "bananamark": "0.1.0",
    "bananamark-codemirror": "0.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "overrides": {
    "markdown-it": "15.0.3",
    "bananamark-codemirror@0.1.0": {
      "@codemirror/view": "$@codemirror/view"
    }
  }
}
