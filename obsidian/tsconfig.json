{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["bench/**/*.ts", "src/**/*.ts", "renderer/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "esbuild.config.ts", "vitest.config.ts"]
}
