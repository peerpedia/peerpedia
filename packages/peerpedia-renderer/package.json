    "entities": "8.1.0",
    "linkedom": "0.18.15",
    "lru-cache": "10.4.3",
    "parse5": "8.1.1"
  },
  "overrides": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "esbuild": "0.28.2",
    "patch-package": "8.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
