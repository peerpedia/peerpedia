{
  "name": "@peerpedia/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./node.mjs",
    "./core": "./core.mjs",
    "./dialect": "./dialect.js",
    "./chapter-title": "./chapter-title.js",
    "./package.json": "./package.json"
  },
  "files": [
