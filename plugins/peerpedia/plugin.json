{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "peerpedia",
  "version": "0.1.0",
  "description": "Find research, understand reader feedback, and propose improvements on Peerpedia.",
  "author": {
    "name": "Chenqi Meng",
    "url": "https://github.com/Chenqitrg"
  },
  "homepage": "https://peerpedia.dev/",
  "repository": "https://github.com/peerpedia/peerpedia",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Peerpedia",
        "shortDescription": "Read research and improve it with reader feedback",
        "developerName": "Chenqi Meng",
        "category": "Productivity",
        "websiteURL": "https://peerpedia.dev/",
        "privacyPolicyURL": "https://peerpedia.dev/privacy/",
        "defaultPrompt": [
          "Find a Peerpedia paper, explain it, and summarize readers' reactions."
        ],
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg"
      }
    }
  }
}
